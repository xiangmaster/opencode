{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
  // validation-only: research gateway provider (auth substitution)
  "provider": {
    "labgw": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "labgw",
      "options": {
        "baseURL": "https://api.openlux.ai/v1",
        "apiKey": "{env:OPENCODE_API_KEY}"
      },
      "models": {
        "gpt-5.6-luna": {},
        "gpt-5.6-sol": {}
      }
    }
  }
}
